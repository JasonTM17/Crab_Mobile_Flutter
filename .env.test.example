# Test Environment Variables (example only)
# Copy to a local, ignored .env.test file if a test runner requires this exact filename.
# All values below are fake test placeholders and must not be used in production.
NODE_ENV=test

# JWT
JWT_SECRET=test-jwt-secret-do-not-use-in-production
JWT_REFRESH_SECRET=test-refresh-secret-do-not-use-in-production
JWT_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800

# Database (overridden by testcontainers in E2E)
DATABASE_URL=postgresql://crab:crab@localhost:5432/crab_test
MONGODB_URI=mongodb://crab:crab@localhost:27017/crab_test
REDIS_URL=redis://localhost:6379/1

# Rate Limiting (relaxed for tests)
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=10000

# Services
GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
USER_SERVICE_PORT=3002
RIDE_SERVICE_PORT=3003
FOOD_SERVICE_PORT=3004
PAYMENT_SERVICE_PORT=3005
CHAT_SERVICE_PORT=3006
NOTIFICATION_SERVICE_PORT=3007
RATING_SERVICE_PORT=3008
