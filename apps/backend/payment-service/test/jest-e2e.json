{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testRegex": ".*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      { "tsconfig": "<rootDir>/tsconfig.e2e.json" }
    ]
  },
  "testEnvironment": "node",
  "moduleNameMapper": {
    "^supertest$": "<rootDir>/../../../../node_modules/supertest"
  },
  "moduleDirectories": [
    "node_modules",
    "../node_modules",
    "../../../../node_modules"
  ]
}
