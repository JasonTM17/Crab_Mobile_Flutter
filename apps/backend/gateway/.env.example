PORT=3000
NODE_ENV=development

# JWT (must match auth-service)
JWT_SECRET=change-me-in-production

# Redis (for Socket.IO multi-instance scaling)
REDIS_URL=redis://localhost:6379

# Downstream services
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
RIDE_SERVICE_URL=http://localhost:3003
FOOD_SERVICE_URL=http://localhost:3004
PAYMENT_SERVICE_URL=http://localhost:3005
CHAT_SERVICE_URL=http://localhost:3006
NOTIFICATION_SERVICE_URL=http://localhost:3007
RATING_SERVICE_URL=http://localhost:3008

# CORS (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:5173

# HTTP client
HTTP_TIMEOUT=10000

# Throttler (legacy, multi-tier config in code)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
