# =============================================================================
# Crab Super App - Production Environment Example
# Copy to .env.production and replace every placeholder before deployment.
# Values here are fake examples only; never commit real credentials.
# =============================================================================

# ─── Image publishing / deployment ────────────────────────────────────────────
DOCKERHUB_NAMESPACE=nguyenson1710
TAG=latest
NODE_ENV=production

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=crab
POSTGRES_PASSWORD=replace_with_strong_postgres_password
POSTGRES_DB=crab_db

# ─── MongoDB ─────────────────────────────────────────────────────────────────
MONGO_USER=crab
MONGO_PASSWORD=replace_with_strong_mongo_password

# ─── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_USER=crab
RABBITMQ_PASSWORD=replace_with_strong_rabbitmq_password

# ─── MinIO / S3-compatible storage ───────────────────────────────────────────
MINIO_USER=crab_minio
MINIO_PASSWORD=replace_with_strong_minio_password

# ─── Auth / JWT ──────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_64_char_random_access_token_secret
JWT_REFRESH_SECRET=replace_with_64_char_random_refresh_token_secret

# ─── Public origins ──────────────────────────────────────────────────────────
CORS_ORIGIN=https://admin.example.com,https://app.example.com
WS_CORS_ORIGIN=https://admin.example.com,https://app.example.com

# ─── Optional push notification credentials ──────────────────────────────────
FCM_PROJECT_ID=
FCM_CREDENTIALS_JSON=
