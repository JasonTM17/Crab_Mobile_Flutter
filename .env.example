# =============================================================================
# Crab Super App - Environment Variables Example
# Copy this file to .env and fill in your values
# =============================================================================

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=crab
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=crab_db
DATABASE_URL=postgresql://crab:change_me_in_prod@localhost:5432/crab_db

# ─── MongoDB ─────────────────────────────────────────────────────────────────
MONGO_USER=crab
MONGO_PASSWORD=change_me_in_prod
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DB=crab
MONGODB_URL=mongodb://crab:change_me_in_prod@localhost:27017/crab?authSource=admin

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ─── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_USER=crab
RABBITMQ_PASSWORD=change_me_in_prod

# ─── MinIO / S3 ──────────────────────────────────────────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USER=crab_minio
MINIO_PASSWORD=change_me_in_prod
MINIO_ROOT_USER=crab_minio
MINIO_ROOT_PASSWORD=change_me_in_prod
MINIO_USE_SSL=false
MINIO_BUCKET=crab-uploads

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_long_random_string
JWT_REFRESH_SECRET=change_me_to_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Services (internal URLs used by gateway in compose) ─────────────────────
AUTH_SERVICE_URL=http://auth-service:3001
USER_SERVICE_URL=http://user-service:3002
RIDE_SERVICE_URL=http://ride-service:3003
FOOD_SERVICE_URL=http://food-service:3004
PAYMENT_SERVICE_URL=http://payment-service:3005
CHAT_SERVICE_URL=http://chat-service:3006
NOTIFICATION_SERVICE_URL=http://notification-service:3007
RATING_SERVICE_URL=http://rating-service:3008
GATEWAY_PORT=3000

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGIN=*
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Docker Hub publish (CI) ─────────────────────────────────────────────────
DOCKERHUB_NAMESPACE=crab
TAG=latest

# ─── Monitoring ──────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_me_in_prod
