# =============================================================================
# Crab Super App - Environment Variables Example
# Copy this file to .env and fill in your values
# =============================================================================

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=crab
POSTGRES_USER=crab
POSTGRES_PASSWORD=crab_secret
DATABASE_URL=postgresql://crab:crab_secret@localhost:5432/crab

# MongoDB
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DB=crab
MONGODB_URL=mongodb://localhost:27017/crab

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=crab_minio
MINIO_ROOT_PASSWORD=crab_minio_secret
MINIO_USE_SSL=false
MINIO_BUCKET=crab-uploads

# JWT
JWT_SECRET=change_me_in_production_use_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Services
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
USER_SERVICE_PORT=3002

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
