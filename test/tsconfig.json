{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2021",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@crab/common-types": ["../packages/common-types/src"],
      "@crab/socket-events": ["../packages/socket-events/src"]
    }
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules"]
}
